[%General]
author=woki
comment=Compact neutral dark theme for mono desktop
contrast=1.00
frame=true
inherits=BreezeDark
isDark=true
kvantum_version=1.0
middle_click_scroll=false
respect_DE=true
single_top_toolbar=true
translucent_windows=false

[GeneralColors]
window.color=#181616
base.color=#1f1d1d
alt.base.color=#242121
button.color=#1f1d1d
light.color=#3a3638
mid.light.color=#2d2a2e
dark.color=#100f0f
mid.color=#2d2a2e
highlight.color=#625e5a
inactive.highlight.color=#3a3638
text.color=#c5c9c5
window.text.color=#c5c9c5
button.text.color=#c5c9c5
highlight.text.color=#f2f0ed
tooltip.text.color=#c5c9c5
tooltip.base.color=#1f1d1d
link.color=#8ba4b0
link.visited.color=#8f8aac

[Hacks]
transparent_dolphin_view=false
transparent_ktitle_label=false
blur_translucent=false
centered_forms=false
combo_as_lineedit=true
kinetic_scrolling=false
middle_click_scroll=false
no_selection_tint=false
noninteger_translucency=false
respect_darkness=true
scroll_min_extent=36
scroll_width=8
slider_width=4
small_icon_size=16
spin_button_width=18

[PanelButtonCommand]
frame=true
frame.element=button
interior=true
interior.element=button
indicator.size=8
text.normal.color=#c5c9c5
text.focus.color=#f2f0ed
text.press.color=#f2f0ed

[Menu]
frame=true
frame.element=menu
interior=true
interior.element=menu
item.margin=2
item.padding=4
separator.margin=3
text.normal.color=#c5c9c5
text.focus.color=#f2f0ed

[Tooltip]
frame=true
interior=true
text.normal.color=#c5c9c5
