* {
    bg:       #181616f2;
    bg-soft:  #1f1d1df2;
    bg-hover: #2a2826f2;
    fg:       #dcd7ba;
    muted:    #8a867f;
    line:     #393836;
    accent:   #8ba4b0;
    selected: #dcd7ba;

    font: "Adwaita Sans 10";
    background-color: transparent;
    text-color: @fg;
}

window {
    location: center;
    anchor: center;
    width: 88%;
    height: 38em;
    padding: 0;
    border: 1px;
    border-radius: 12px;
    border-color: @line;
    background-color: @bg;
}

mainbox {
    orientation: vertical;
    children: [ "listview" ];
    spacing: 0;
    padding: 0;
    background-color: transparent;
}

inputbar {
    enabled: false;
}

listview {
    columns: 3;
    lines: 3;
    spacing: 0.65em;
    padding: 0.65em;
    cycle: true;
    dynamic: true;
    fixed-height: true;
    fixed-columns: true;
    scrollbar: true;
    background-color: transparent;
}

element {
    orientation: vertical;
    children: [ "element-icon", "element-text" ];
    spacing: 0.25em;
    padding: 0.3em;
    border: 1px;
    border-radius: 8px;
    border-color: transparent;
    background-color: @bg-soft;
    text-color: @fg;
}

element selected {
    border-color: @accent;
    background-color: @bg-hover;
    text-color: @selected;
}

element-icon {
    size: 15em;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    border-radius: 6px;
    background-color: transparent;
}

element-text {
    enabled: true;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "Adwaita Sans 10";
    text-color: @fg;
    background-color: transparent;
}
