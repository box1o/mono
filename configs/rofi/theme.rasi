* {
    bg:       #181616f2;
    panel:    #1f1d1df2;
    hover:    #2a2826f2;
    fg:       #dcd7ba;
    muted:    #8a867f;
    line:     #393836;
    accent:   #8ba4b0;

    font: "JetBrains Mono Nerd Font 10";
    background-color: transparent;
    text-color: @fg;
}

window {
    location: center;
    anchor: center;
    width: 64em;
    height: 34em;
    padding: 0;
    border: 1px;
    border-radius: 10px;
    border-color: @line;
    background-color: @bg;
}

mainbox {
    orientation: horizontal;
    children: [ "preview", "content" ];
    spacing: 0;
    padding: 0;
    background-color: transparent;
}

preview {
    width: 36em;
    expand: false;
    background-image: url("~/.config/hypr/img/mandalorian.jpg", height);
    background-color: @bg;
}

content {
    width: 32em;
    expand: false;
    orientation: vertical;
    children: [ "inputbar", "listview" ];
    spacing: 0;
    padding: 1.2em;
    background-color: @panel;
}

inputbar {
    children: [ "entry" ];
    padding: 0 0 0.9em 0;
    margin: 0;
    border: 0 0 1px 0;
    border-color: @line;
    background-color: transparent;
}

entry {
    placeholder: "Search";
    placeholder-color: @muted;
    cursor-color: @accent;
    text-color: @fg;
    background-color: transparent;
}

listview {
    columns: 1;
    lines: 9;
    spacing: 0.18em;
    padding: 0.9em 0 0 0;
    cycle: true;
    dynamic: true;
    fixed-height: true;
    fixed-columns: true;
    scrollbar: false;
    background-color: transparent;
    text-color: @fg;
}

element {
    orientation: horizontal;
    children: [ "element-icon", "element-text" ];
    spacing: 0.75em;
    padding: 0.45em 0.55em;
    border-radius: 7px;
    background-color: transparent;
    text-color: @fg;
}

element selected {
    background-color: @hover;
    text-color: @fg;
}

element-icon {
    size: 2.2em;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

prompt,
case-indicator,
mode-switcher,
message,
textbox-prompt-colon {
    enabled: false;
}
