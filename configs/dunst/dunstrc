[global]
    monitor = 0
    follow = mouse
    width = 320
    height = (0, 140)
    origin = top-right
    offset = (10, 26)
    notification_limit = 5
    indicate_hidden = yes
    shrink = no
    transparency = 0
    separator_height = 1
    padding = 6
    horizontal_padding = 8
    text_icon_padding = 6
    frame_width = 1
    frame_color = "#393836"
    separator_color = frame
    sort = yes
    idle_threshold = 0

    font = JetBrains Mono 9
    line_height = 1
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = -1
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 18
    max_icon_size = 22
    icon_theme = "breeze-dark,Adwaita"
    enable_recursive_icon_lookup = true
    history_length = 30
    dmenu = /usr/bin/rofi -dmenu -i -p dunst:
    browser = /usr/bin/zen-browser -new-tab
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 4
    ignore_dbusclose = false

    mouse_left_click = do_action, close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = context, close_current
    close = ctrl+space
    close_all = ctrl+shift+space

[urgency_low]
    background = "#181616f2"
    foreground = "#a6aaa6"
    frame_color = "#393836"
    timeout = 4

[urgency_normal]
    background = "#181616f5"
    foreground = "#c5c9c5"
    frame_color = "#625e5a"
    timeout = 5

[urgency_critical]
    background = "#181616f7"
    foreground = "#c5c9c5"
    frame_color = "#c4746e"
    timeout = 0
