class DeviceControlApp(App[None]):
    CSS = """
    Screen {
        background: #111111;
        color: #eeeeee;
        layout: vertical;
    }

    #command-tabs {
        height: 1fr;
        min-height: 12;
        padding: 0 1;
        background: #111111;
    }

    TabPane {
        padding: 0;
        background: #111111;
    }

    DataTable {
        height: 1fr;
        border: none;
        background: #111111;
    }

    #custom-pane {
        padding: 1;
        height: 1fr;
        background: #111111;
    }

    #custom-input {
        margin: 1 0;
    }

    #output {
        height: 20;
        padding: 0 1;
        margin: 0;
        border: none;
        background: #0b0b0b;
    }
    """

    BINDINGS = [
        ("q", "quit", "Quit"),
        ("r", "run_selected", "Run"),
        ("x", "cancel_command", "Stop"),
        ("c", "copy_output", "Copy"),
        ("d", "next_device", "Device"),
        ("+", "output_bigger", "Output+"),
        ("-", "output_smaller", "Output-"),
        ("f5", "refresh_devices", "Refresh"),
        ("ctrl+l", "clear_output", "Clear"),
    ]

    def __init__(self, container: str) -> None:
        super().__init__()
        self.config = load_config()
        self.container = container
        self.devices: list[str] = []
        self.current_device = ""
        self.selected_command: CommandSpec | None = None
        configured_height = self.config.get("output_height", DEFAULT_OUTPUT_HEIGHT)
        self.output_height = configured_height if isinstance(configured_height, int) else DEFAULT_OUTPUT_HEIGHT
        self.running_task: asyncio.Task[None] | None = None
        self.current_process: asyncio.subprocess.Process | None = None
        self.output_lines: list[str] = []

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        with TabbedContent(id="command-tabs"):
            for category in ("Presets", "PX", "Media", "Logs", "Liberty", "GW"):
                with TabPane(category, id=f"tab-{category.lower()}"):
                    table = DataTable(
                        id=f"table-{category.lower()}",
                        show_header=False,
                        show_row_labels=False,
                        cell_padding=0,
                    )
                    table.cursor_type = "row"
                    table.zebra_stripes = False
                    table.add_column("Command")
                    for spec in self.commands_for(category):
                        table.add_row(spec.label, key=spec.label)
                    yield table

            with TabPane("Custom", id="tab-custom"):
                with Vertical(id="custom-pane"):
                    yield Input(placeholder="example: px db", id="custom-input")

        yield RichLog(id="output", wrap=True, highlight=True, markup=True)
        yield Footer()

    async def on_mount(self) -> None:
        self.title = "dcmd"
        self.query_one("#output", RichLog).styles.height = self.output_height
        await self.refresh_devices()
        self.select_first_command()

    @staticmethod
    def commands_for(category: str) -> list[CommandSpec]:
        return [command for command in COMMANDS if command.category == category]

    def select_first_command(self) -> None:
        for category in ("Presets", "PX", "Media", "Logs", "Liberty", "GW"):
            commands = self.commands_for(category)
            if commands:
                self.selected_command = commands[0]
                return

    async def refresh_devices(self) -> None:
        output = await self.run_host("docker", "ps", "--format", "{{.Names}}")
        if self.container not in output.splitlines():
            self.set_status(f"container not running: {self.container}")
            self.log_error(f"Container '{self.container}' is not running.")
            return

        command = f"find {shlex.quote(INSTALL_ROOT)} -mindepth 1 -maxdepth 1 -type d -printf '%f\\n' | sort"
        output = await self.run_host("docker", "exec", self.container, "bash", "-lc", command)
        self.devices = [line.strip() for line in output.splitlines() if line.strip()]

        if not self.devices:
            self.current_device = ""
            self.set_status("no installed devices found")
            return

        last_device = self.config.get("device")
        if isinstance(last_device, str) and last_device in self.devices:
            self.current_device = last_device
        else:
            self.current_device = "cc0002" if "cc0002" in self.devices else self.devices[0]
        self.set_status("ready")
        self.log_info(f"Loaded devices: {', '.join(self.devices)}")

    async def run_host(self, *args: str) -> str:
        process = await asyncio.create_subprocess_exec(
            *args,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE,
        )
        stdout, stderr = await process.communicate()
        text = stdout.decode(errors="replace")
        err = stderr.decode(errors="replace")
        if process.returncode != 0:
            return f"{text}{err}"
        return text

    async def run_device_command(self, spec: CommandSpec) -> None:
        if not self.current_device:
            self.log_error("No device selected.")
            return

        command = spec.command.format(device=self.current_device)
        profile = f"{INSTALL_ROOT}/{self.current_device}/home/fmc/.profile"
        inner = f"source {shlex.quote(profile)}; {command}"

        self.clear_output()
        self.set_status(f"running: {spec.label}")
        self.log_info(f"$ {command}")

        try:
            process = await asyncio.create_subprocess_exec(
                "docker",
                "exec",
                self.container,
                "bash",
                "-lc",
                inner,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.STDOUT,
            )
            self.current_process = process
            assert process.stdout is not None

            while True:
                chunk = await process.stdout.readline()
                if not chunk:
                    break
                self.write_output(chunk.decode(errors="replace").rstrip())

            code = await process.wait()
            if code == 0:
                self.set_status(f"done: {spec.label}")
                self.log_info(f"exit status: {code}")
            else:
                self.set_status(f"failed: {spec.label}")
                self.log_error(f"exit status: {code}")
        except asyncio.CancelledError:
            self.set_status(f"cancelled: {spec.label}")
            self.log_error(f"cancelled: {spec.label}")
            raise
        finally:
            self.current_process = None
            self.running_task = None

    def set_status(self, text: str) -> None:
        device = self.current_device or "no-device"
        self.sub_title = f"{self.container} / {device} / {text}"

    def log_info(self, text: str) -> None:
        self.write_output(text, markup=f"[bold]{text}[/bold]")

    def log_error(self, text: str) -> None:
        self.write_output(text, markup=f"[bold red]{text}[/bold red]")

    def write_output(self, text: str, markup: str | None = None) -> None:
        self.output_lines.append(text)
        self.query_one("#output", RichLog).write(markup if markup is not None else text)

    def action_run_selected(self) -> None:
        if not self.selected_command:
            return

        if self.running_task and not self.running_task.done():
            self.log_error("A command is already running. Press x to stop it first.")
            return

        self.running_task = asyncio.create_task(self.run_device_command(self.selected_command))

    def action_cancel_command(self) -> None:
        asyncio.create_task(self.cancel_running_command())

    async def cancel_running_command(self) -> None:
        process = self.current_process
        if not process or process.returncode is not None:
            self.log_error("No running command to stop.")
            return

        self.set_status("stopping command")
        self.log_info("Stopping running command...")
        process.terminate()
        try:
            await asyncio.wait_for(process.wait(), timeout=2)
        except asyncio.TimeoutError:
            process.kill()
            await process.wait()

    def action_clear_output(self) -> None:
        self.clear_output()

    def clear_output(self) -> None:
        self.output_lines.clear()
        self.query_one("#output", RichLog).clear()

    def action_copy_output(self) -> None:
        text = "\n".join(self.output_lines).rstrip() + "\n"
        path = "/tmp/mgw-device-ui-output.txt"
        with open(path, "w", encoding="utf-8") as file:
            file.write(text)

        self.log_info(f"Output saved to {path}")
        asyncio.create_task(self.copy_to_clipboard(text, path))

    async def copy_to_clipboard(self, text: str, path: str) -> None:
        if shutil.which("wl-copy") and os.environ.get("WAYLAND_DISPLAY"):
            try:
                process = await asyncio.create_subprocess_exec(
                    "wl-copy",
                    stdin=asyncio.subprocess.PIPE,
                    stdout=asyncio.subprocess.DEVNULL,
                    stderr=asyncio.subprocess.DEVNULL,
                )
                assert process.stdin is not None
                process.stdin.write(text.encode())
                await process.stdin.drain()
                process.stdin.close()
                self.log_info("Output sent to wl-copy clipboard")
                return
            except OSError as error:
                self.log_error(f"wl-copy failed: {error}")

        commands = (
            ("xclip", "-selection", "clipboard"),
            ("xsel", "--clipboard", "--input"),
            ("pbcopy",),
        )
        for command in commands:
            if not shutil.which(command[0]):
                continue
            if command[0] in {"xclip", "xsel"} and not os.environ.get("DISPLAY"):
                continue
            try:
                process = await asyncio.create_subprocess_exec(
                    *command,
                    stdin=asyncio.subprocess.PIPE,
                    stdout=asyncio.subprocess.DEVNULL,
                    stderr=asyncio.subprocess.PIPE,
                )
                _, stderr = await asyncio.wait_for(
                    process.communicate(text.encode()),
                    timeout=1.5,
                )
            except asyncio.TimeoutError:
                process.kill()
                await process.wait()
                self.log_error(f"{command[0]} timed out; output remains saved to {path}")
                continue

            if process.returncode == 0:
                self.log_info(f"Output copied to clipboard")
                return

            error = stderr.decode(errors="replace").strip()
            if error:
                self.log_error(f"{command[0]} failed: {error}")

        self.log_info(f"Clipboard unavailable; output remains saved to {path}")

    async def action_refresh_devices(self) -> None:
        await self.refresh_devices()

    def action_next_device(self) -> None:
        if not self.devices:
            self.log_error("No devices loaded.")
            return

        if self.current_device not in self.devices:
            self.current_device = self.devices[0]
        else:
            index = self.devices.index(self.current_device)
            self.current_device = self.devices[(index + 1) % len(self.devices)]

        self.set_status("device changed")
        self.config["device"] = self.current_device
        save_config(self.config)
        self.log_info(f"Selected device: {self.current_device}")

    def action_output_bigger(self) -> None:
        self.output_height += 3
        self.query_one("#output", RichLog).styles.height = self.output_height
        self.config["output_height"] = self.output_height
        save_config(self.config)
        self.set_status(f"output height {self.output_height}")

    def action_output_smaller(self) -> None:
        self.output_height = max(6, self.output_height - 3)
        self.query_one("#output", RichLog).styles.height = self.output_height
        self.config["output_height"] = self.output_height
        save_config(self.config)
        self.set_status(f"output height {self.output_height}")

    def action_quit(self) -> None:
        process = self.current_process
        if process and process.returncode is None:
            process.terminate()
        self.exit()

    @on(Input.Submitted, "#custom-input")
    def on_custom_submitted(self, event: Input.Submitted) -> None:
        text = event.value.strip()
        if text:
            if self.running_task and not self.running_task.done():
                self.log_error("A command is already running. Press x to stop it first.")
                return
            self.running_task = asyncio.create_task(
                self.run_device_command(CommandSpec("Custom", "custom", "User-entered command.", text))
            )

    @on(DataTable.RowSelected)
    def on_row_selected(self, event: DataTable.RowSelected) -> None:
        table_id = event.data_table.id or ""
        category = table_id.removeprefix("table-").title()
        if category == "Px":
            category = "PX"
        label = str(event.row_key.value)
        self.selected_command = next(
            (command for command in COMMANDS if command.category == category and command.label == label),
            None,
        )
        self.action_run_selected()

    @on(DataTable.RowHighlighted)
    def on_row_highlighted(self, event: DataTable.RowHighlighted) -> None:
        table_id = event.data_table.id or ""
        category = table_id.removeprefix("table-").title()
        if category == "Px":
            category = "PX"
        label = str(event.row_key.value)
        self.selected_command = next(
            (command for command in COMMANDS if command.category == category and command.label == label),
            None,
        )


def running_containers() -> list[str]:
    result = subprocess.run(
        ["docker", "ps", "--format", "{{.Names}}"],
        text=True,
        capture_output=True,
    )
    if result.returncode != 0:
        message = result.stderr.strip() or result.stdout.strip() or "docker ps failed"
        raise SystemExit(message)
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def choose_container() -> str:
    containers = running_containers()
    if DEFAULT_CONTAINER in containers:
        return DEFAULT_CONTAINER

    if not containers:
        raise SystemExit(f"No running Docker containers found. Expected default: {DEFAULT_CONTAINER}")

    if not sys.stdin.isatty():
        raise SystemExit(
            f"Default container '{DEFAULT_CONTAINER}' is not running. "
            f"Set DEV_CONTAINER to one of: {', '.join(containers)}"
        )

    print(f"Default container '{DEFAULT_CONTAINER}' is not running.")
    print("Select Docker container:")
    for index, name in enumerate(containers, start=1):
        print(f"  {index}. {name}")

    while True:
        value = input("> ").strip()
        if value.isdigit() and 1 <= int(value) <= len(containers):
            return containers[int(value) - 1]
        if value in containers:
            return value
        print("Invalid selection.")


def has_terminal() -> bool:
    return sys.stdin.isatty() and sys.stdout.isatty()


def terminal_command(script_path: str) -> list[str] | None:
    candidates = (
        ("kitty", "--title", "dcmd", script_path),
        ("ghostty", "--title=dcmd", "-e", script_path),
        ("alacritty", "--title", "dcmd", "-e", script_path),
        ("foot", "-T", "dcmd", script_path),
        ("wezterm", "start", "--", script_path),
        ("konsole", "--new-tab", "-p", "tabtitle=dcmd", "-e", script_path),
        ("gnome-terminal", "--title=dcmd", "--", script_path),
        ("xfce4-terminal", "--title=dcmd", "--command", script_path),
        ("xterm", "-T", "dcmd", "-e", script_path),
    )
    for command in candidates:
        if shutil.which(command[0]):
            return list(command)
    return None


def relaunch_in_terminal_if_needed() -> None:
    if has_terminal() or os.environ.get(TERMINAL_ENV):
        return

    script_path = os.path.abspath(__file__)
    command = terminal_command(script_path)
    if command is None:
        raise SystemExit(
            "No terminal attached and no supported terminal emulator found. "
            "Install kitty, ghostty, alacritty, foot, wezterm, konsole, gnome-terminal, xfce4-terminal, or xterm."
        )

    os.environ[TERMINAL_ENV] = "1"
    os.execvp(command[0], command)


def main() -> None:
    relaunch_in_terminal_if_needed()
    DeviceControlApp(choose_container()).run()


if __name__ == "__main__":
    main()
