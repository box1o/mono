#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("MONO_CONFIG_HOME", Path.home() / ".config" / "mono"))
CONFIG_FILE = CONFIG_DIR / "dcmd.json"


@dataclass(frozen=True)
class Command:
    name: str
    body: str


COMMANDS = [
    Command("activate", "px app stop || true; px cfg start; px app activate; px media create || true; px app start; px app status; px db"),
    Command("clean-activate", "px app stop || true; px cfg start; px app activate; px media create || true; px app start; px app status; px db"),
    Command("restart", "px app stop || true; px app start; px app status"),
    Command("reset-db", "px app stop || true; px db reset; px app start; px app status; px db"),
    Command("card-in", "$PCR event input reader inserted=true; $PCR event input card inserted=true; px db"),
    Command("card-out", "$PCR event input card inserted=false; $PCR event input reader inserted=false; px db"),
    Command("px-status", "px status"),
    Command("px-db", "px db"),
    Command("px-env", "px env"),
    Command("logs", "px log last 120"),
]


def load_config() -> dict[str, str]:
    try:
        data = json.loads(CONFIG_FILE.read_text())
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}

    return data if isinstance(data, dict) else {}


def save_config(config: dict[str, str]) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")


def config_value(config: dict[str, str], key: str, env_key: str | None = None) -> str:
    env_key = env_key or key.upper()
    value = os.environ.get(env_key) or config.get(key) or ""
    return str(value)


def require_value(config: dict[str, str], key: str, env_key: str | None = None) -> str:
    value = config_value(config, key, env_key)
    if not value:
        raise SystemExit(f"missing {key} in {CONFIG_FILE}")
    return value


def run(args: list[str]) -> str:
    return subprocess.run(args, text=True, capture_output=True, check=False).stdout


def running_containers() -> list[str]:
    output = run(["docker", "ps", "--format", "{{.Names}}"])
    return [line for line in output.splitlines() if line]


def choose_container(config: dict[str, str], requested: str | None) -> str:
    available = running_containers()
    wanted = requested or config_value(config, "container", "DCMD_CONTAINER")

    if wanted and wanted in available:
        return wanted

    if wanted and not available:
        raise SystemExit(f"container is not running: {wanted}")

    if not available:
        raise SystemExit("no running Docker containers found")

    if wanted:
        raise SystemExit(f"container is not running: {wanted}")

    return available[0]


def installed_devices(container: str, install_root: str) -> list[str]:
    command = f"find {install_root} -mindepth 1 -maxdepth 1 -type d -printf '%f\\n' | sort"
    result = subprocess.run(
        ["docker", "exec", container, "bash", "-lc", command],
        text=True,
        capture_output=True,
        check=False,
    )

    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or result.stdout.strip())

    return [line for line in result.stdout.splitlines() if line]


def choose_device(config: dict[str, str], container: str, install_root: str, requested: str | None) -> str:
    found = installed_devices(container, install_root)
    if not found:
        raise SystemExit(f"no devices found under {install_root}")

    candidates = [requested, config.get("device"), found[0]]
    for candidate in candidates:
        if candidate in found:
            config["device"] = candidate
            save_config(config)
            return str(candidate)

    return found[0]


def command_by_name(name: str) -> Command:
    for command in COMMANDS:
        if command.name == name:
            return command

    raise SystemExit(f"unknown command: {name}")


def run_device_command(container: str, install_root: str, profile_relpath: str, device: str, body: str) -> int:
    profile = f"{install_root}/{device}/{profile_relpath}"
    inner = f"source {profile}; {body}"
    tty = "-it" if sys.stdin.isatty() else "-i"

    return subprocess.call(["docker", "exec", tty, container, "bash", "-lc", inner])


def interactive(container: str, install_root: str, profile_relpath: str, device: str) -> int:
    names = [command.name for command in COMMANDS]
    picker = shutil.which("fzf")

    if picker:
        result = subprocess.run(
            [picker, "--prompt", f"{container}/{device}> "],
            input="\n".join(names),
            text=True,
            capture_output=True,
            check=False,
        )
        selected = result.stdout.strip()
    else:
        print("\n".join(names))
        selected = input("> ").strip()

    if not selected:
        return 0

    return run_device_command(
        container,
        install_root,
        profile_relpath,
        device,
        command_by_name(selected).body,
    )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("command", nargs="?", help="command name or raw command with --raw")
    parser.add_argument("--container")
    parser.add_argument("--device")
    parser.add_argument("--raw", action="store_true")
    parser.add_argument("--list", action="store_true")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    config = load_config()

    if args.list:
        print("\n".join(command.name for command in COMMANDS))
        return 0

    install_root = require_value(config, "install_root", "DCMD_INSTALL_ROOT")
    profile_relpath = require_value(config, "profile_relpath", "DCMD_PROFILE_RELPATH")
    container = choose_container(config, args.container)
    device = choose_device(config, container, install_root, args.device)

    if not args.command:
        return interactive(container, install_root, profile_relpath, device)

    body = args.command if args.raw else command_by_name(args.command).body
    return run_device_command(container, install_root, profile_relpath, device, body)


if __name__ == "__main__":
    raise SystemExit(main())
