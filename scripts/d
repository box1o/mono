#!/usr/bin/env bash
# GBashLib-compatible runner for ./d.bl.sh (gblcmd_* commands).

set -eo pipefail

D_SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
D_BL_SH_DIR=""
D_BL_SH_FILE=""
_NAME=d
_ALLCMDS=()

gbl() {
	case "${1:-}" in
	log) printf '%s\n' "$D_SCRIPT_DIR/d-log.lib.sh" ;;
	d_lib)
		case "${2:-}" in
		docs | "") printf '%s\n' "$D_SCRIPT_DIR/d-stub.lib.sh" ;;
		*) return 1 ;;
		esac
		;;
	*) return 1 ;;
	esac
}

_d_fatal() {
	echo -e "FATAL:\t $*\n\n---try help command for more information: d help\n" >&2
	exit 1
}

_d_err() {
	echo -e "ERROR:\t $*" >&2
}

_d_usage() {
	local name descr args var var_args cmds_text=''

	echo "Usage:"
	echo "d [OPTIONS] command1 arg1 arg2 -- command2 arg1 arg2 -- ..."
	echo ""
	echo "COMMANDS:"
	mapfile -t _ALLCMDS < <(_d_list_commands_raw)
	for name in "${_ALLCMDS[@]}"; do
		var="gblcmd_descr_${name}"
		descr="${!var:-}"
		var_args="gblcmd_descr_${name}[1]"
		args="${!var_args:-}"
		if [[ -z "$args" ]]; then
			args='-'
		fi
		cmds_text+=$'\t'"  $name $args $descr"$'\n'
	done
	echo -e "$cmds_text"
	echo ""
	echo "AUTOCOMPLETE: eval \"\$( d _print_autocomplete )\""
}

_d_list_commands_raw() {
	compgen -A function |
		sed -n 's/^gblcmd_\([^[:space:]]*\)$/\1/p' |
		grep -Ev '^(descr_|autocomp_)' |
		sort -u
}

_d_refresh_commands() {
	mapfile -t _ALLCMDS < <(_d_list_commands_raw)
	_ALLCMDS+=("--")
}

_d_has_bl() {
	local dir="${1:-.}"
	[[ -f "$dir/d.bl.sh" || -d "$dir/d.bl.sh" ]]
}

_d_resolve_bl() {
	local dir="${1:-.}"

	if [[ -d "$dir/d.bl.sh" ]]; then
		D_BL_SH_DIR="$(cd -- "$dir/d.bl.sh" && pwd)"
		D_BL_SH_FILE="$D_BL_SH_DIR"
		return 0
	fi

	if [[ -f "$dir/d.bl.sh" ]]; then
		D_BL_SH_DIR="$(cd -- "$dir" && pwd)"
		D_BL_SH_FILE="$D_BL_SH_DIR/d.bl.sh"
		return 0
	fi

	return 1
}

# NOTE: d.bl.sh must be sourced here (top level), not inside a function —
# declare -A in project scripts is invisible to gblcmd_* otherwise.

gblcmd_descr_zhelp='print help information (this screen)'
gblcmd_zhelp() {
	_d_usage
	echo ""
	echo "G FUNCTIONS:"
	local fn descr var
	while IFS= read -r fn; do
		[[ "$fn" == gbl_* ]] || continue
		var="gbl_descr_${fn#gbl_}"
		descr="${!var:-}"
		echo -e "\t${fn} : $descr"
	done < <(compgen -A function | grep -e '^gbl_' || true)
	echo ""
}
_d_print_autocomplete_bash_code() {
	local scriptpath="$D_SCRIPT_DIR/d"
	local name="${2:-d}"

	cat <<EOF
_d_bac_d(){
local cur=\${COMP_WORDS[COMP_CWORD]}
local prev=\${COMP_WORDS[COMP_CWORD-1]}
COMPREPLY=(\$($scriptpath _print_autocomplete_result \$COMP_CWORD \${COMP_WORDS[@]}))
} ; complete -r ./$name $name >/dev/null 2>&1; complete -F _d_bac_d $name
EOF
}

_d_print_autocomplete_result() {
	local cword="$1"
	shift
	shift
	local -a rez=("${_ALLCMDS[@]}")
	local filter="" unknown="no"
	local -a arr=("$@")
	local i j=0 cmd="" x z

	if (($# == 1)) && (($# == cword)); then
		filter="$1"
	else
		for ((i = 0; i < $#; i++)); do
			if [[ "${arr[i]}" == "--" ]]; then
				((j = i + 1))
				cmd=""
			fi
			if ((j == i)); then
				cmd="${arr[i]}"
			fi
		done
		((z = i - 1))
		if ((z == j)) && (($# == cword)); then
			filter="$cmd"
		else
			if [[ -n "$cmd" ]]; then
				((x = i - j))
				if (($# == cword)); then
					((--x))
					((z = $# - 1))
					filter="${arr[z]}"
				fi
				local var_name="gblcmdautocomp_${cmd}_$x"
				local var_value="${!var_name:-}"
				if [[ -n "$var_value" ]]; then
					read -ra rez <<< "$(eval "$var_value")"
				else
					var_name="gblcmdautocomp_${cmd}_0"
					var_value="${!var_name:-}"
					if [[ -n "$var_value" ]]; then
						read -ra rez <<< "$(eval "$var_value" "$x")"
					else
						unknown="yes"
					fi
				fi
			fi
		fi
	fi

	if [[ "$unknown" == "yes" ]]; then
		read -ra rez <<< "$(ls)"
	fi

	if [[ -n "$filter" ]]; then
		if [[ "$unknown" == "yes" ]]; then
			read -ra rez <<< "$(ls "$(dirname "$filter")" 2>/dev/null || true)"
			filter="${filter##*/}"
		fi
		for i in "${rez[@]}"; do
			if [[ "$i" =~ $filter ]]; then
				printf '%s\n' "$i"
			fi
		done
	else
		printf '%s\n' "${rez[@]}"
	fi
}

_d_print_autocomplete() {
	_d_print_autocomplete_bash_code "$@"
}

_d_print_zsh_setup() {
	cat <<'EOF'
_d_zsh() {
	local -a words_copy reply_arr
	local cword=$((CURRENT - 1))

	command d _has_bl >/dev/null 2>&1 || {
		_message -r 'no ./d.bl.sh in this directory'
		return 1
	}

	words_copy=("${words[@]}")
	reply_arr=("${(@f)$(command d _print_autocomplete_result $cword ${words_copy[@]} 2>/dev/null)}")
	(( ${#reply_arr} )) || return 0
	compadd -- "${reply_arr[@]}"
}

compdef _d_zsh d
EOF
}

_d_dispatch() {
	local cmd cmd_args=()
	local cmd_run_count=0
	local -a detect=()
	local i resolved

	while (($# > 0)); do
		cmd="$1"
		[[ -z "$cmd" ]] && break
		shift
		cmd_args=()
		i=0

		while (($# > 0)); do
			[[ -z "$1" ]] && break
			if [[ "$1" == "--" ]]; then
				shift
				break
			fi
			((++i))
			cmd_args[i]=$1
			shift
		done

		if ! declare -F "gblcmd_$cmd" >/dev/null 2>&1; then
			detect=()
			for resolved in "${_ALLCMDS[@]}"; do
				if [[ "$resolved" == "--" ]]; then
					continue
				fi
				if [[ "$resolved" =~ $cmd ]]; then
					detect+=("$resolved")
				fi
			done
			if ((${#detect[@]} > 0)); then
				if ((${#detect[@]} > 1)); then
					_d_fatal "ambiguous command '$cmd' -> ( ${detect[*]} )"
				else
					log "$cmd -> ${detect[0]}"
					cmd="${detect[0]}"
				fi
			else
				_d_err "command '$cmd' is not found!"
				_d_usage
				exit 127
			fi
		fi

		gblcmd_$cmd "${cmd_args[@]}"
		cmd_run_count=1
	done

	if [[ "$cmd_run_count" != "1" ]]; then
		_d_usage
	fi
}

_d_meta() {
	case "${1:-}" in
	_print_autocomplete) _d_print_autocomplete "${@:2}" ;;
	_print_zsh_setup) _d_print_zsh_setup ;;
	_has_bl) _d_has_bl "." && exit 0 || exit 1 ;;
	_list_commands) _d_list_commands_raw ;;
	*) return 1 ;;
	esac
}

case "${1:-}" in
_print_autocomplete)
	_d_meta "$1" "${@:2}"
	exit 0
	;;
_print_autocomplete_result | _list_commands)
	_d_resolve_bl "." || _d_fatal "there is no ./d.bl.sh to run in this directory"
	if [[ -d "$D_BL_SH_FILE" ]]; then
		shopt -s nullglob
		for _d_bl_file in "$D_BL_SH_FILE"/*.bl.sh; do
			# shellcheck source=/dev/null
			source "$_d_bl_file"
		done
		shopt -u nullglob
	else
		# shellcheck source=/dev/null
		source "$D_BL_SH_FILE"
	fi
	unset _d_bl_file
	_d_refresh_commands
	[[ "$1" == "_print_autocomplete_result" ]] && {
		_d_print_autocomplete_result "${@:2}"
		exit 0
	}
	_d_meta "$1"
	exit 0
	;;
_print_zsh_setup | _has_bl)
	_d_meta "$1"
	exit $?
	;;
*)
	_d_resolve_bl "." || _d_fatal "there is no ./d.bl.sh to run in this directory"
	if [[ -d "$D_BL_SH_FILE" ]]; then
		shopt -s nullglob
		for _d_bl_file in "$D_BL_SH_FILE"/*.bl.sh; do
			# shellcheck source=/dev/null
			source "$_d_bl_file"
		done
		shopt -u nullglob
	else
		# shellcheck source=/dev/null
		source "$D_BL_SH_FILE"
	fi
	unset _d_bl_file
	_d_refresh_commands
	_d_dispatch "$@"
	;;
esac
